POSTGRES_DB=manutencao
POSTGRES_USER=manutencao
POSTGRES_PASSWORD=troque-esta-senha

# Login da aplicação (HTTP Basic). Sem estas variáveis, valem os padrões de demonstração do docker-compose.yml.
APP_AUTH_USERNAME=operador
APP_AUTH_PASSWORD=troque-esta-senha

# Porta do PostgreSQL no host (publicada só em 127.0.0.1). Troque se a 5432 já estiver em uso.
DB_PORT=5432

# Fuso que define o "hoje" das regras de data (agendamento e painel).
APP_TIMEZONE=America/Sao_Paulo
